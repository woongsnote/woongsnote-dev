---
import { PostCompactItem } from '@/components/post';
import { LIMITS, siteConfig } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts } from '@/lib/posts';

const allPosts = await getPosts();
const homePosts = allPosts.slice(0, LIMITS.homePostCount);
const totalPostCount = allPosts.length;
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <div class="mx-auto max-w-4xl pt-5 pb-12">
    <h1 class="text-meta leading-relaxed break-keep">
      직접 만든 블로그로, 직접 쓰는 개발 기록.
    </h1>
    <ul class="mt-5 flex flex-col gap-1 md:gap-3">
      {homePosts.map((post) => <PostCompactItem post={post} />)}
    </ul>
    <nav class="mt-10" aria-label="게시물 탐색">
      <a
        href="/archive"
        class="focus-ring text-base-content/70 hover:text-primary rounded-sm text-sm font-semibold transition-colors duration-150 ease-out active:opacity-70 motion-reduce:transition-none"
      >
        All {totalPostCount} Posts →
      </a>
    </nav>
  </div>
</BaseLayout>
