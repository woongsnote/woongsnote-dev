---
import { TOC } from '@/config';
import type { MarkdownHeading } from 'astro';

type Props = { headings: MarkdownHeading[] };

const { headings } = Astro.props;

const toc = headings.filter((h) => h.depth === TOC.depth);
---

{
  toc.length >= 2 && (
    <details
      open
      data-pagefind-ignore
      class="collapse-arrow not-prose bg-base-200/35 collapse mt-6 rounded-lg"
    >
      <summary class="focus-ring collapse-title min-h-0 py-3 text-sm font-semibold after:scale-90 after:opacity-60">
        목차
      </summary>

      <nav aria-label="목차" class="collapse-content">
        <ul class="list-none space-y-1.5 pl-0">
          {toc.map((h) => (
            <li class="py-0.5">
              <a
                href={`#${h.slug}`}
                class="text-base-content/70 hover:text-primary text-sm no-underline transition-colors"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}
