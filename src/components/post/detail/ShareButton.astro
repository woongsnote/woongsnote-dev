---
import Share from '@/icons/share.svg';

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
---

<button
  id="shareButton"
  type="button"
  class="focus-ring btn btn-circle btn-ghost btn-sm text-neutral-content hover:text-primary focus-visible:text-primary border-transparent hover:border-transparent hover:bg-transparent"
  data-title={title}
  data-url={url}
  aria-label="글 공유"
>
  <Share aria-hidden="true" class="inline-block size-5" />
</button>

<script>
  import { sharePost } from '@/lib/share';

  const button = document.getElementById('shareButton');
  button?.addEventListener('click', () => {
    const title = button.getAttribute('data-title') ?? '';
    const url = button.getAttribute('data-url') ?? '';
    sharePost(title, url);
  });
</script>
