---
import { formatDate } from '@/lib/date';
import type { PostEntry } from '@/types';

type Props = {
  post: PostEntry;
  yearLabel?: number;
  headingLevel?: 'h2' | 'h3';
};

const {
  post: {
    id,
    data: { title, publishedDate },
  },
  yearLabel,
  headingLevel: Tag = 'h2',
} = Astro.props;
---

<li
  class:list={[
    'border-base-content/10 border-b',
    yearLabel !== undefined && 'not-first:mt-6 md:not-first:mt-0',
  ]}
>
  <a
    href={`/${id}`}
    class="focus-ring group grid min-h-11 grid-cols-[5ch_minmax(0,1fr)] items-baseline gap-x-4 gap-y-3 py-3 text-sm md:grid-cols-[6ch_5ch_minmax(0,1fr)] md:gap-x-6 md:py-4"
  >
    {yearLabel !== undefined && (
      <span
        aria-hidden="true"
        class="border-base-content/10 text-neutral-content col-span-full border-b pb-2 font-semibold tabular-nums md:col-span-1 md:border-0 md:pb-0"
      >
        {yearLabel}
      </span>
    )}
    <time
      datetime={publishedDate.toISOString()}
      class="text-neutral-content tabular-nums md:col-start-2"
    >
      <span class="sr-only">{publishedDate.getFullYear()}년 </span>
      {formatDate(publishedDate, 'month-day')}
    </time>
    <Tag class="text-base-content group-hover:text-primary group-focus-visible:text-primary text-base leading-snug font-semibold tracking-tight wrap-anywhere break-keep md:text-lg">
      {title}
    </Tag>
  </a>
</li>
