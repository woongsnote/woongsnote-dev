---
import { formatDate } from '@/lib/date';
import type { PostEntry } from '@/types';

type Props = {
  post: PostEntry;
  layout?: 'home' | 'archive';
  yearLabel?: number;
  headingLevel?: 'h2' | 'h3';
};

const {
  post: {
    id,
    data: { title, publishedDate },
  },
  layout = 'home',
  yearLabel,
  headingLevel: Tag = 'h2',
} = Astro.props;

const homeLayout = layout === 'home';
const startsYear = homeLayout && yearLabel !== undefined;
---

<li
  class:list={[
    'border-base-content/10 border-b',
    startsYear && 'not-first:mt-6 md:not-first:mt-0',
  ]}
>
  <a
    href={`/${id}`}
    class:list={[
      'focus-ring group grid min-h-11 grid-cols-[5ch_minmax(0,1fr)] items-baseline gap-x-3 gap-y-3 py-3 text-sm md:gap-x-6 md:py-4',
      homeLayout && 'md:grid-cols-[6ch_5ch_minmax(0,1fr)]',
    ]}
  >
    {startsYear && (
      <span
        aria-hidden="true"
        class="border-base-content/10 text-neutral-content col-span-full border-b pb-2 font-semibold tabular-nums md:col-span-1 md:border-0 md:pb-0"
      >
        {yearLabel}
      </span>
    )}
    <time
      datetime={publishedDate.toISOString()}
      class:list={[
        'text-neutral-content tabular-nums',
        homeLayout && 'md:col-start-2',
      ]}
    >
      <span class="sr-only">{publishedDate.getFullYear()}년 </span>
      {formatDate(publishedDate, 'month-day')}
    </time>
    <Tag class="text-base-content group-hover:text-primary group-focus-visible:text-primary text-base leading-snug font-medium tracking-normal wrap-anywhere break-keep md:text-lg">
      {title}
    </Tag>
  </a>
</li>
