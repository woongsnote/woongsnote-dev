---
import { formatDate } from '@/lib/date';
import type { PostEntry } from '@/types';

type Props = {
  post: PostEntry;
  headingLevel?: 'h2' | 'h3';
};

const {
  post: {
    id,
    data: { title, description, publishedDate, category },
  },
  headingLevel: Tag = 'h2',
} = Astro.props;
---

<li>
  <a
    href={`/${id}`}
    class="focus-ring group -mx-2 block rounded-sm px-2 py-4 no-underline transition-opacity duration-150 ease-out active:opacity-80 motion-reduce:transition-none md:py-5"
  >
    <Tag
      class="text-base-content group-hover:text-primary group-focus-visible:text-primary text-base leading-snug font-semibold tracking-tight break-words transition-colors duration-150 ease-out motion-reduce:transition-none md:text-lg"
    >
      {title}
    </Tag>

    <p
      class="text-base-content/65 mt-1.5 line-clamp-1 text-sm leading-relaxed break-keep sm:line-clamp-2"
    >
      {description}
    </p>

    <div
      class="text-meta mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 tracking-wide"
    >
      <time datetime={publishedDate.toISOString()} class="tabular-nums">
        {formatDate(publishedDate)}
      </time>
      <span aria-hidden="true">·</span>
      <span class="uppercase">{category}</span>
    </div>
  </a>
</li>
