---
import SearchIcon from '@/icons/search.svg';
import HeaderTooltip from '@/components/common/HeaderTooltip.astro';
---

<div class="search-shortcut relative">
  <button
    type="button"
    data-search-open
    aria-label="검색 열기"
    aria-describedby="search-shortcut-hint"
    class="header-icon focus-ring text-neutral-content hover:text-base-content focus-visible:text-base-content flex size-11 cursor-pointer items-center justify-center rounded-full transition-colors duration-150 ease-out active:opacity-70 motion-reduce:transition-none"
  >
    <SearchIcon aria-hidden="true" class="size-5" />
  </button>
  <HeaderTooltip
    id="search-shortcut-hint"
    label="검색 · Ctrl/⌘ K"
    align="end"
  />
</div>
