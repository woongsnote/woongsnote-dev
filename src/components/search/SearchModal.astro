---
/**
 * 검색 모달 – native <dialog> + daisyUI modal
 *
 * - ESC 닫기: <dialog> 네이티브
 * - 배경 클릭 닫기: <form method="dialog"> 네이티브
 * - ⌘K / Ctrl+K: search-modal.ts 에서 처리
 * - 모바일 닫기 버튼: form method="dialog"
 * - ↑↓ Enter 키보드 탐색: search-modal.ts 에서 처리
 */
---

<dialog
  aria-label="블로그 검색"
  data-pagefind-ignore
  data-search-modal
  class="modal px-3"
>
  <div class="modal-box border-base-content/10 bg-base-100/95 max-w-2xl overflow-hidden rounded-2xl border p-0 shadow-2xl backdrop-blur-xl">
    <!-- 검색 입력 -->
    <div class="border-base-content/10 flex items-center gap-2 border-b px-4 py-3">
      <input
        type="text"
        placeholder="Search..."
        aria-label="검색어"
        aria-controls="search-results"
        aria-describedby="search-status"
        enterkeyhint="search"
        autocomplete="off"
        spellcheck="false"
        class="input input-ghost h-11 w-full px-0 focus:outline-none"
        autofocus
        data-search-input
      />

      <kbd class="border-base-content/20 text-base-content/50 hidden rounded-md border px-1.5 py-0.5 font-mono text-[10px] sm:inline">
        ESC
      </kbd>

      <button
        type="submit"
        form="search-close"
        aria-label="닫기"
        class="focus-ring text-base-content/40 hover:text-base-content flex size-9 shrink-0 items-center justify-center rounded-full transition-colors duration-150 ease-out sm:hidden"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- 결과 목록 -->
    <div class="max-h-[min(60vh,32rem)] overflow-y-auto overscroll-contain p-2">
      <p
        id="search-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        class="text-base-content/60 px-3 py-2 text-sm"
        data-search-status
      >
        검색어를 입력해 주세요.
      </p>
      <ul
        id="search-results"
        aria-label="검색 결과"
        class="flex flex-col gap-1"
        data-results
      ></ul>
      <div class="px-3 py-4 text-sm" data-search-error hidden>
        <p>검색하지 못했어요. 잠시 후 다시 시도해 주세요.</p>
        <button
          type="button"
          class="focus-ring mt-2 min-h-11 rounded-md px-3"
          data-search-retry
        >
          다시 검색
        </button>
      </div>

      <p
        class="text-base-content/60 py-8 text-center text-sm"
        data-empty
        hidden
      >
        {import.meta.env.DEV
          ? '개발 환경에서는 검색을 사용할 수 없어요. 빌드 후 preview에서 확인해 주세요.'
          : '검색 결과가 없어요.'}
      </p>
    </div>

    <!-- 하단 힌트 -->
    <div class="border-base-content/10 bg-base-200/40 text-base-content/50 flex items-center justify-between border-t px-4 py-2.5 text-xs">
      <span>↑↓ 탐색 · Enter 이동</span>
      <span class="hidden sm:inline">⌘K / Ctrl+K 열기</span>
    </div>
  </div>

  <!-- 배경 클릭 닫기 -->
  <form id="search-close" method="dialog" class="modal-backdrop">
    <button aria-label="검색 닫기">close</button>
  </form>
</dialog>

<script>
  import './search-modal';
</script>
