---
/**
 * 검색 모달 – native <dialog> + daisyUI modal
 *
 * - ESC 닫기: <dialog> 네이티브
 * - 배경 클릭 닫기: <form method="dialog"> 네이티브
 * - ⌘K / Ctrl+K: search-modal.ts 에서 처리
 * - 모바일 닫기 버튼: data-search-close
 * - ↑↓ Enter 키보드 탐색: search-modal.ts 에서 처리
 */
---

<dialog data-pagefind-ignore data-search-modal class="modal px-3">
  <div
    class="modal-box border-base-content/10 bg-base-100/95 max-w-2xl overflow-hidden rounded-2xl border p-0 shadow-2xl backdrop-blur-xl"
  >
    <!-- 검색 입력 -->
    <div
      class="border-base-content/10 flex items-center gap-2 border-b px-4 py-3"
    >
      <input
        type="text"
        placeholder="Search..."
        aria-label="검색어"
        autocomplete="off"
        spellcheck="false"
        class="input input-ghost h-11 w-full px-0 focus:outline-none"
        data-search-input
      />

      <kbd
        class="border-base-content/20 text-base-content/50 hidden rounded-md border px-1.5 py-0.5 font-mono text-[10px] sm:inline"
      >
        ESC
      </kbd>

      <button
        type="button"
        data-search-close
        aria-label="닫기"
        class="text-base-content/40 hover:text-base-content focus-visible:ring-primary/40 flex size-9 shrink-0 items-center justify-center rounded-full transition-colors duration-150 ease-out focus-visible:ring-2 focus-visible:outline-none sm:hidden"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- 결과 목록 -->
    <div class="max-h-[min(60vh,32rem)] overflow-y-auto overscroll-contain p-2">
      <ul class="flex flex-col gap-1" data-results></ul>

      <p
        class="text-base-content/60 py-8 text-center text-sm"
        data-empty
        hidden
      >
        검색 결과가 없어요.
      </p>
    </div>

    <!-- 하단 힌트 -->
    <div
      class="border-base-content/10 bg-base-200/40 text-base-content/50 flex items-center justify-between border-t px-4 py-2.5 text-xs"
    >
      <span>↑↓ 탐색 · Enter 이동</span>
      <span class="hidden sm:inline">⌘K / Ctrl+K 열기</span>
    </div>
  </div>

  <!-- 배경 클릭 닫기 -->
  <form method="dialog" class="modal-backdrop">
    <button aria-label="검색 닫기">close</button>
  </form>
</dialog>

<script>
  import './search-modal';
</script>
