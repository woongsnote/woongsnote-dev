---
import SearchButton from '../search/SearchButton.astro';

import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/about', label: 'about' },
  { href: '/archive', label: 'archive' },
] as const;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActivePath = (href: string) => {
  const normalizedHref = href.replace(/\/$/, '') || '/';

  return (
    pathname === normalizedHref || pathname.startsWith(`${normalizedHref}/`)
  );
};

const navLinkBaseClass =
  'focus-ring relative rounded-sm py-1 text-xs tracking-wide transition-colors duration-150 ease-out sm:text-sm';
---

<header
  class="bg-base-200/90 border-base-content/5 sticky top-0 z-50 h-16 border-b backdrop-blur-md"
>
  <div class="navbar mx-auto max-w-4xl px-2 lg:px-0">
    <div class="flex-1">
      <a
        href="/"
        class="focus-ring text-base-content hover:text-primary rounded-sm text-lg font-semibold tracking-tight transition-colors duration-150 ease-out"
      >
        woongsnote
      </a>
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <nav aria-label="주 메뉴" class="flex items-center gap-4 sm:gap-5">
        {
          navLinks.map(({ href, label }) => {
            const isActive = isActivePath(href);

            return (
              <a
                href={href}
                class:list={[
                  navLinkBaseClass,
                  isActive
                    ? 'text-base-content'
                    : 'text-neutral-content hover:text-base-content',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {label}
                {isActive && (
                  <span
                    aria-hidden="true"
                    class="bg-primary absolute inset-x-1 -bottom-1.5 h-px rounded-full"
                  />
                )}
              </a>
            );
          })
        }
      </nav>

      <SearchButton />
      <ThemeToggle />
    </div>
  </div>
</header>
