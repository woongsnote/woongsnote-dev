---
import ArchiveIcon from '@/icons/archive.svg';
import UserRoundIcon from '@/icons/user-round.svg';
import SearchButton from '../search/SearchButton.astro';
import HeaderTooltip from './HeaderTooltip.astro';
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/about', label: 'about' },
  { href: '/archive', label: 'archive' },
] as const;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActivePath = (href: string) => {
  const normalizedHref = href.replace(/\/$/, '') || '/';

  return (
    pathname === normalizedHref || pathname.startsWith(`${normalizedHref}/`)
  );
};

const navLinkBaseClass =
  'focus-ring relative inline-flex h-11 items-center rounded-sm px-2 text-sm tracking-wide transition-colors duration-150 ease-out';
const mobileIconClass =
  'header-icon focus-ring flex size-11 items-center justify-center rounded-full transition-colors duration-150 ease-out active:opacity-70 motion-reduce:transition-none';
---

<header
  class="bg-base-200/90 border-base-content/5 sticky top-0 z-50 h-16 border-b backdrop-blur-md"
>
  <div class="mx-auto flex h-full w-full max-w-4xl items-center px-4">
    <a
      href="/"
      class="focus-ring text-base-content hover:text-primary inline-flex min-h-11 shrink-0 items-center rounded-sm text-lg font-semibold tracking-tight transition-colors duration-150 ease-out"
    >
      woongsnote
    </a>

    <div class="ml-auto flex shrink-0 items-center gap-0 md:gap-2">
      <nav aria-label="주 메뉴" class="flex items-center md:hidden">
        <div class="relative">
          <a
            href="/about"
            aria-label="About · 소개"
            aria-current={isActivePath('/about') ? 'page' : undefined}
            class:list={[
              mobileIconClass,
              isActivePath('/about')
                ? 'text-primary'
                : 'text-neutral-content hover:text-base-content',
            ]}
          >
            <UserRoundIcon aria-hidden="true" class="size-5" />
          </a>
          <HeaderTooltip label="About · 소개" />
        </div>

        <div class="relative">
          <a
            href="/archive"
            aria-label="Archive · 전체 글"
            aria-current={isActivePath('/archive') ? 'page' : undefined}
            class:list={[
              mobileIconClass,
              isActivePath('/archive')
                ? 'text-primary'
                : 'text-neutral-content hover:text-base-content',
            ]}
          >
            <ArchiveIcon aria-hidden="true" class="size-5" />
          </a>
          <HeaderTooltip label="Archive · 전체 글" />
        </div>
      </nav>

      <nav aria-label="주 메뉴" class="hidden items-center gap-2 md:flex">
        {
          navLinks.map(({ href, label }) => {
            const isActive = isActivePath(href);

            return (
              <a
                href={href}
                class:list={[
                  navLinkBaseClass,
                  isActive
                    ? 'text-base-content'
                    : 'text-neutral-content hover:text-base-content',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {label}
                {isActive && (
                  <span
                    aria-hidden="true"
                    class="bg-primary absolute inset-x-2 bottom-1 h-px rounded-full"
                  />
                )}
              </a>
            );
          })
        }
      </nav>

      <SearchButton />
      <div class="-mr-3">
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
