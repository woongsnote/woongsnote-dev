---
import { SOCIALS } from '@/config';

const year = new Date().getFullYear();
---

<footer class="border-base-content/5 mt-auto border-t px-4 py-4">
  <div
    class="mx-auto flex w-full max-w-4xl flex-col-reverse items-center justify-between gap-3 text-xs tracking-wide md:flex-row md:items-baseline"
  >
    <div
      class="flex flex-col items-center gap-1 md:flex-row md:items-baseline md:gap-2"
    >
      <p class="text-meta">
        &copy; {year} woongsnote
      </p>
      <span aria-hidden="true" class="text-neutral-content/50 hidden md:inline"
        >·</span
      >
      <p class="text-base-content/70">Build. Learn. Record.</p>
    </div>

    <nav aria-label="소셜 링크" class="flex gap-4">
      {
        SOCIALS.map(({ title, url }) => {
          return (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="link-muted focus-ring rounded-sm font-medium no-underline"
              aria-label={`${title} 페이지로 이동`}
            >
              <span>{title}</span>
            </a>
          );
        })
      }
    </nav>
  </div>
</footer>
