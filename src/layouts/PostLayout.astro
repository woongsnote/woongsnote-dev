---
import {
  Comments,
  FooterNavigation,
  ReadingProgress,
  ShareButton,
  TagList,
  Thumbnail,
  Toc,
} from '@/components/post';
import { formatDate } from '@/lib/date';
import type { PostEntry } from '@/types';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';

type Props = {
  post: PostEntry;
  headings: MarkdownHeading[];
  readingTime: number | null;
  previousPost?: PostEntry | null;
  nextPost?: PostEntry | null;
  relatedPosts?: PostEntry[];
};

const {
  post,
  headings,
  readingTime,
  previousPost = null,
  nextPost = null,
  relatedPosts = [],
} = Astro.props;

const {
  title,
  description,
  publishedDate,
  tags,
  category,
  link,
  cover,
  coverAlt,
} = post.data;

const isProject = category === 'Project';
const postDate = formatDate(publishedDate);
---

<BaseLayout
  title={title}
  description={description}
  image={`/${post.id}/og.png`}
  articleDate={publishedDate.toISOString()}
>
  <ReadingProgress />

  <article
    data-pagefind-body
    class="prose mx-auto w-full max-w-3xl pt-8 pb-16 break-keep sm:pt-10"
  >
    <div data-reading-progress-content>
      <header class="not-prose mb-10 sm:mb-12">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="text-meta tracking-wide uppercase">{category}</span>
          <TagList tags={tags} />
        </div>

        <h1
          data-pagefind-weight="10"
          data-pagefind-meta="title"
          class="text-base-content mt-4 text-3xl leading-[1.15] font-semibold tracking-tight text-balance sm:text-4xl lg:text-[2.75rem]"
        >
          {title}
        </h1>

        <p
          class="text-base-content/70 mt-4 text-base leading-relaxed break-keep sm:text-lg"
        >
          {description}
        </p>

        <div
          class="mt-5 flex flex-wrap items-center justify-between gap-x-4 gap-y-3"
        >
          <div class="text-meta flex flex-wrap items-center gap-2">
            <time datetime={publishedDate.toISOString()}>{postDate}</time>
            {
              readingTime !== null && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>{`${readingTime}분 읽기`}</span>
                </>
              )
            }
          </div>
          <ShareButton title={title} url={Astro.url.href} />
        </div>
      </header>
      <Toc headings={headings} />
      {
        isProject && cover && (
          <Thumbnail
            image={cover}
            alt={coverAlt ?? title}
            title={title}
            link={link}
          />
        )
      }

      <div data-post-body>
        <slot />
      </div>
    </div>

    <FooterNavigation
      previousPost={previousPost}
      nextPost={nextPost}
      relatedPosts={relatedPosts}
    />

    <Comments />
  </article>
</BaseLayout>
